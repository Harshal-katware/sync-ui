{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },

    "ignoreDeprecations": "6.0",

    "skipLibCheck": true,
    "isolatedModules": true
  }
}